# Environment Configuration for ShieldNet
APP_NAME="ShieldNet — Cybersecurity Intelligence Platform"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (Local SQLite default)
DATABASE_URL="sqlite:///./scamshield.db"

# Security & Authentication
SECRET_KEY="insecure-hackathon-secret-key-change-in-production-shieldnet-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=100

# CORS Configuration:
# Comma-separated list of explicitly allowed origins (no wildcards allowed when credentials are true).
# In production, set this to your exact Vercel frontend URL, e.g. "https://shieldnet.vercel.app"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Optional regex for Vercel deployment preview URLs (set to "none" to disable)
ALLOWED_ORIGIN_REGEX="https://.*\.vercel\.app"

# Optional External AI API Key for Plain-Language Explanations
# By default, external LLM is DISABLED and local deterministic engines are used.
# If enabled, raw messages are NEVER sent; only extracted non-sensitive indicators and redacted context are transmitted.
ENABLE_EXTERNAL_LLM=False
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
