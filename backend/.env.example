# Environment Configuration for ScamShield + ScamTrace

APP_NAME="ScamShield + Intelligent Scam Network Mapper"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (Local SQLite default)
DATABASE_URL="sqlite:///./scamshield.db"

# Security & Authentication
SECRET_KEY="insecure-hackathon-secret-key-change-in-production-scamshield-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Optional External AI API Key (Default is disabled, local curated engines used)
ENABLE_EXTERNAL_LLM=False
GROQ_API_KEY=""
